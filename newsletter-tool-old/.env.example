# Gmail (required)
# Gmail's SMTP host; leave it as is for a Gmail account
SMTP_HOST=smtp.gmail.com
# 465 is TLS from the first byte, which is what Gmail expects
SMTP_PORT=465
# The Gmail account that sends the issue
SMTP_USER=sedgardoh@gmail.com
# A 16-character App Password without spaces (Google Account > Security > 2-Step Verification > App passwords), never the account password
SMTP_PASS=
# Where the issue is delivered; falls back to SMTP_USER when blank
TO_EMAIL=sedgardoh@gmail.com

# Writer (optional)
# Where Ollama listens; a default install needs no change
OLLAMA_URL=http://localhost:11434
# Blank = auto-pick (qwen3.5:4b, gemma4:e4b, qwen3.5:9b, else any installed model); name one to force it, after ollama pull
OLLAMA_MODEL=

# Claude (optional)
# web (default) needs no API key; anthropic has Claude search and write and needs ANTHROPIC_API_KEY
RESEARCH_PROVIDER=web
# Only used when RESEARCH_PROVIDER=anthropic; from console.anthropic.com
ANTHROPIC_API_KEY=
# The Claude model the anthropic provider calls
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback for the anthropic provider; set 0 to turn it off
ANTHROPIC_FALLBACKS=1

# App
# The server listens on http://localhost:PORT; anything outside 1 to 65535 falls back to 3000
PORT=3000
# Repository link shown in the email footer
REPO_URL=https://github.com/S4ul1to/portfolio
